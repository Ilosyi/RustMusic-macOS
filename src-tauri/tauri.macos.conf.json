{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RustMusic",
        "width": 1280,
        "height": 880,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 18 },
        "transparent": false,
        "resizable": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0b0b10",
        "shadow": true
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"]
  }
}
