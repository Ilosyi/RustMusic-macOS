+pub fn roots(conn: &Connection) -> Vec<RootInfo> {
+    roots_list(conn)
+        .into_iter()
+        .map(|root| {
+            let (count, size) = conn
+                .query_row(
+                    "SELECT COUNT(*), COALESCE(SUM(size),0) FROM baidu_tracks WHERE root = ?1",
+                    params![root],
+                    |r| Ok((r.get::<_, i64>(0)?, r.get::<_, i64>(1)?)),
+                )
+                .unwrap_or((0, 0));
+            RootInfo {
+                root,
+                count: count as u32,
+                size: size.max(0) as u64,
+            }
+        })
+        .collect()
+}
